{
  "permissions": {
    "allow": [
      "Bash(npm --version)",
      "Bash(java -version)",
      "Bash(npm install *)",
      "Bash(npx tsc *)",
      "Bash(npx expo-doctor *)",
      "Bash(npx expo *)",
      "Bash(npm start *)",
      "PowerShell($conn = Get-NetTCPConnection -LocalPort 8081 -ErrorAction SilentlyContinue | Select-Object -First 1; if \\($conn\\) { $proc = Get-Process -Id $conn.OwningProcess -ErrorAction SilentlyContinue; Write-Output \"Port 8081 owned by PID $\\($conn.OwningProcess\\) \\($\\($proc.ProcessName\\)\\)\" } else { Write-Output \"Port 8081 is free\" })",
      "Bash(curl -s -H \"Expo-Platform: android\" -H \"Accept: application/expo+json,application/json\" http://localhost:8081/)",
      "Bash(curl -s 'https://maps.googleapis.com/maps/api/geocode/json?latlng=35.6762,139.6503&key=AIzaSyDptWdZugy-Ovvhp6vMv753Hd9XysGiUA8')",
      "Bash(curl -sS -o /tmp/geo.json -w 'HTTP %{http_code}\\\\n' 'https://maps.googleapis.com/maps/api/geocode/json?latlng=35.6762,139.6503&key=AIzaSyDptWdZugy-Ovvhp6vMv753Hd9XysGiUA8')",
      "Read(//tmp/**)",
      "Bash(curl -sS -k --ssl-revoke-best-effort 'https://maps.googleapis.com/maps/api/geocode/json?latlng=35.6762,139.6503&key=AIzaSyDptWdZugy-Ovvhp6vMv753Hd9XysGiUA8')",
      "Bash(npx eas-cli *)",
      "Bash(EXPO_TOKEN=$\\(cat .eas-token\\) npx eas-cli init --non-interactive --force)",
      "Bash(export EXPO_TOKEN=$\\(cat .eas-token\\))",
      "Bash(git init *)",
      "Bash(git add *)"
    ]
  }
}
